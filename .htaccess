# =============================================
# Punto de entrada único del proyecto
# =============================================
# El proyecto se puede servir de dos formas:
#
#   1. DocumentRoot apuntando a public/ (VirtualHost). Es la opción recomendada
#      y la más segura: el resto del proyecto queda fuera de la raíz web.
#   2. Copiando la carpeta completa dentro de htdocs y entrando por
#      http://localhost/ProyectoBasket/. En este caso este archivo redirige
#      todas las peticiones al index.php de la raíz, que delega en
#      public/index.php.
#
# En ambos casos deben quedar inaccesibles:
#
#   - app/                 -> código y configuración (incluye credenciales)
#   - database/            -> esquema y hashes de las contraseñas de prueba
#   - doc/, vault/, tests/ -> documentación y pruebas internas
#   - .git/                -> código fuente e historial completo
#
# Las reglas se comparan con rutas RELATIVAS a esta carpeta, así que el nombre
# de la carpeta de instalación puede cambiar sin tocar nada.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Carpetas internas: prohibidas siempre (403).
    RewriteRule ^(app|database|doc|vault|tests|\.git)(/|$) - [F,L]

    # 2. Archivos ocultos (.git, .env, .htaccess...). Se deja pasar
    #    .well-known/ porque lo usan los certificados TLS.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # 3. Recursos estáticos: viven en public/ pero se sirven desde la raíz,
    #    para que las vistas funcionen igual con o sin /public/ en la URL.
    RewriteRule ^(css|js|img|assets)/(.*)$ public/$1/$2 [L]

    # 4. Acceso directo a public/: se mantiene por compatibilidad.
    RewriteRule ^public/ - [L]

    # 5. Todo lo demás pasa por el front controller de la raíz.
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>

# Sin mod_rewrite no se puede garantizar que solo se sirva index.php.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</IfModule>

# Evita que Apache liste el contenido de una carpeta sin index.
Options -Indexes

# Documentación, scripts y volcados que no deben descargarse aunque estén
# en la raíz del proyecto.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(md|sql|sh|pdf|log|ini|yml|yaml|json|lock|bak|old|dist)$">
        Require all denied
    </FilesMatch>
</IfModule>
